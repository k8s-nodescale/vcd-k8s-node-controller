#!/usr/bin/env bash
# vCD guest-customization initscript: configure the NIC, seed NoCloud with the
# embedded user-data, then run cloud-init. Mirrors templates/customization_node.sh.
set -euo pipefail

LOG=/var/log/vcd-cloudinit.log
exec >>"$LOG" 2>&1
log() { echo "[$(date -Is)] $*"; }
log "starting vCD guest customization initscript"

NIC="{{ .NICName }}"
NODE_IP="{{ .NodeIP }}"
CIDR_PREFIX="{{ .CIDRPrefix }}"
GATEWAY="{{ .GatewayIP }}"
DNS_JSON='{{ .DNSServersJSON }}'

cat > /etc/netplan/50-cloud-init.yaml <<EOF
network:
  version: 2
  ethernets:
    ${NIC}:
      dhcp4: false
      addresses: [${NODE_IP}/${CIDR_PREFIX}]
      routes:
        - to: default
          via: ${GATEWAY}
      nameservers:
        addresses: ${DNS_JSON}
EOF
chmod 600 /etc/netplan/50-cloud-init.yaml
if ! netplan apply; then
  log "netplan apply failed"
fi

mkdir -p /var/lib/cloud/seed/nocloud
cat > /var/lib/cloud/seed/nocloud/meta-data <<EOF
instance-id: {{ .NodeName }}
local-hostname: {{ .NodeName }}
EOF

base64 -d <<'CLOUDINIT' | gzip -d > /var/lib/cloud/seed/nocloud/user-data
{{ .CloudInitBase64Gz }}
CLOUDINIT

{{- if .Disks }}
# Prepare the extra data disks before cloud-init starts. The script is also
# listed in cloud-init bootcmd, so it still runs after the one-time reboot if
# this customization script is not executed again.
cat > /usr/local/sbin/prepare-data-disks.sh <<'DISKSETUP'
{{ .DiskSetupScript }}
DISKSETUP
chmod 0700 /usr/local/sbin/prepare-data-disks.sh
rc=0
/usr/local/sbin/prepare-data-disks.sh || rc=$?
if [[ "$rc" -eq 42 ]]; then
  # The disk script requested a reboot; cloud-init will run on the next boot.
  exit 0
fi
if [[ "$rc" -ne 0 ]]; then
  exit "$rc"
fi
{{- end }}

run() {
  local desc="$1"
  shift
  local rc=0
  "$@" || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    log "$desc failed with exit code $rc"
  fi
  return 0
}

run "cloud-init init --local" cloud-init init --local
run "cloud-init init" cloud-init init
run "cloud-init modules --mode=config" cloud-init modules --mode=config
run "cloud-init modules --mode=final" cloud-init modules --mode=final
log "vCD guest customization initscript finished"

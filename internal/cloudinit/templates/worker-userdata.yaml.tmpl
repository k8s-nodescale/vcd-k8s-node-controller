#cloud-config
preserve_hostname: false
hostname: {{ .NodeName }}
fqdn: {{ .NodeName }}

users:
  - name: {{ .OSUser }}
    groups: [sudo]
    shell: /bin/bash
    {{- if .OSPasswordHash }}
    passwd: {{ .OSPasswordHash }}
    {{- end }}
    {{- if .SSHAuthorizedKey }}
    ssh_authorized_keys:
      - {{ .SSHAuthorizedKey }}
    {{- end }}

ssh_pwauth: false

{{- if .Disks }}
bootcmd:
  - |
    /usr/local/sbin/prepare-data-disks.sh
    rc=$?
    if [ "$rc" -ne 0 ] && [ "$rc" -ne 42 ]; then
      exit "$rc"
    fi
{{- end }}

write_files:
  - path: /etc/netplan/50-cloud-init.yaml
    permissions: '0600'
    content: |
      network:
        version: 2
        ethernets:
          {{ .NICName }}:
            dhcp4: false
            addresses: [{{ .NodeIP }}/{{ .CIDRPrefix }}]
            routes:
              - to: default
                via: {{ .GatewayIP }}
            nameservers:
              addresses: {{ .DNSServersJSON }}

  - path: /etc/modules-load.d/k8s.conf
    content: |
      overlay
      br_netfilter

  - path: /etc/sysctl.d/k8s.conf
    content: |
      net.bridge.bridge-nf-call-iptables  = 1
      net.bridge.bridge-nf-call-ip6tables = 1
      net.ipv4.ip_forward                 = 1

  - path: /etc/containerd/config.toml
    content: |
      version = 2
      root = "/var/lib/containerd"
      state = "/run/containerd"
      [plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runc.options]
        SystemdCgroup = true

  - path: /etc/kubernetes/join-command.sh
    permissions: '0700'
    content: |
      #!/bin/bash
      set -euo pipefail
      {{ .JoinCommand }}

  - path: /usr/local/sbin/k8s-node-bootstrap.sh
    permissions: '0700'
    content: |
      #!/bin/bash
      set -euo pipefail
      # ---------------------------------------------------------------------------
      # TODO(option-A): implement OS preparation + cluster join here.
      # See conception.md section 5.4 and the Ansible roles:
      #   - prepare_k8s_nodes     (LVM, /var -> /data1, /var/lib -> /data2, reboot)
      #   - install_k8s_binaries  (pkgs.k8s.io repo, pinned kubeadm/kubelet/kubectl)
      # Then run /etc/kubernetes/join-command.sh after the reboot.
      #
      # The detailed disk/reboot/idempotency mechanics are intentionally deferred
      # (conception.md 3.2) and will be implemented before this path is enabled.
      # ---------------------------------------------------------------------------
      echo "k8s-node-bootstrap: not implemented yet" >&2
      exit 1

runcmd:
  - /usr/local/sbin/k8s-node-bootstrap.sh

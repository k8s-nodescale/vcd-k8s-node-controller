#cloud-config
# {{ .RenderStamp }}
preserve_hostname: false
hostname: {{ .NodeName }}
fqdn: {{ .NodeName }}

users:
  - name: {{ .OSUser }}
    groups: [sudo]
    shell: /bin/bash
    # cloud-init locks the account when a passwd hash is set unless this is
    # false; a locked account cannot authenticate for sudo, which the operator
    # needs on a guest that failed a stage.
    lock_passwd: false
    {{- if .OSPasswordHash }}
    passwd: {{ .OSPasswordHash }}
    {{- end }}
    {{- if .SSHAuthorizedKey }}
    ssh_authorized_keys:
      - {{ .SSHAuthorizedKey }}
    {{- end }}

# The Terraform baseline allows password login, and an operator locked out of a
# worker that failed a stage needs it. Key-only would be a different policy than
# the one the cluster's own images are built with.
ssh_pwauth: true

{{- if .OSPasswordHash }}
# The image may already carry the account (the Terraform images create it).
# cloud-init's users module leaves an existing account's password alone, so the
# hash from the pool has to be applied through chpasswd as well - otherwise a
# worker built by the controller has a locked-out or unknown password while the
# spec says which one it must have.
chpasswd:
  expire: false
  users:
    - name: {{ .OSUser }}
      password: {{ .OSPasswordHash }}
      type: hash
{{- end }}

# Same apt policy as the Terraform baseline: retry a slow mirror, wait for the
# dpkg lock instead of failing, and never update or upgrade on its own.
apt:
  conf: |
    Acquire {
      Retries "60"
    }
    DPkg {
      Lock {
        Timeout "60"
      }
    }

package_update: false
package_upgrade: false

# Declarative only: two boot steps, everything else is a file or a unit. See
# customization-phases.md §4.2 - work that can fail slowly or needs a retry
# belongs in a systemd unit, not here.
bootcmd:
{{- if .OSPasswordHash }}
  # Early and unconditional: a worker whose disk stage fails must still be
  # reachable with the password the pool says it has. The users module skips an
  # account the image already carries, so the hash is applied here as well. The
  # hash is single-quoted: unquoted, the shell expands "$6$..." into nothing and
  # chpasswd receives a corrupted hash.
  - |
    printf '%s\n' '{{ .OSUser }}:{{ .OSPasswordHash }}' | chpasswd -e || true
{{- end }}
  # The image ships /etc/security/access.conf ending in "-:ALL:ALL" with
  # pam_access enabled for login and sshd, so an account without an allow line
  # cannot log in at all - console included. The Terraform baseline inserts the
  # same line for the cluster account.
  - |
    grep -q '^+:{{ .OSUser }}:ALL$' /etc/security/access.conf 2>/dev/null ||
      sed -i '/^-:ALL:ALL/i +:{{ .OSUser }}:ALL' /etc/security/access.conf
  - |
    if [ -x /usr/local/sbin/prepare-data-disks.sh ]; then
      /usr/local/sbin/prepare-data-disks.sh || echo "prepare-data-disks.sh failed, continuing"
    fi
  - |
    systemctl daemon-reload || true
    systemctl enable --now --no-block k8s-node-prereqs.service || true

write_files:
  # Fallback network config for the case where the vCD customization phase did
  # not run; the initscript writes 01-netplan.yaml and removes this file.
  - path: /etc/netplan/50-cloud-init.yaml
    permissions: '0600'
    content: |
      network:
        version: 2
        ethernets:
          {{ .NICName }}:
            dhcp4: false
            addresses: [{{ .NodeIP }}/{{ .CIDRPrefix }}]
            routes:
              - to: default
                via: {{ .GatewayIP }}
            nameservers:
              addresses: {{ .DNSServersJSON }}
{{- if .DNSServersLine }}
  # The Terraform baseline writes the resolvers twice: netplan for the
  # interface and a resolved drop-in. Netplan alone is enough until a second
  # source (a DHCP lease on another NIC, a package that ships its own drop-in)
  # takes the default route; Domains=~. pins the global resolver set.
  - path: /etc/systemd/resolved.conf.d/nodescale.conf
    permissions: '0644'
    content: |
      [Resolve]
      DNS={{ .DNSServersLine }}
      Domains=~.
{{- end }}

  # Parity with the Terraform baseline: a password login that works when a
  # worker has to be rescued by hand. 0600 because sshd refuses a group- or
  # world-writable include file. The matching apt policy is written by the
  # pre-requisites script, after the Pro packages that own 10periodic are gone.
  - path: /etc/sudoers.d/{{ .OSUser }}
    permissions: '0440'
    content: |
      # Written by the node controller, mirroring the Terraform baseline so a
      # worker that failed a stage can be inspected without a password prompt.
      Defaults:{{ .OSUser }} !requiretty
      {{ .OSUser }} ALL=(ALL) NOPASSWD: ALL

  - path: /etc/ssh/sshd_config.d/01-k8s-auth.conf
    content: |
      PubkeyAuthentication yes
      PasswordAuthentication yes
      KbdInteractiveAuthentication yes
      PermitRootLogin no
    permissions: '0600'

  {{- range .CACertFiles }}
  # bootstrap.caBundleRef: one file per certificate, then one
  # update-ca-certificates run in runcmd. The Terraform baseline does the same
  # through cloud-init's ca_certs.trusted.
  - path: {{ .Path }}
    permissions: '0644'
    content: |
{{ .Content }}
  {{- end }}

  # The Terraform baseline writes every node of the cluster into /etc/hosts, so
  # a worker can resolve its peers before DNS knows them. The controller knows
  # the pool's own workers (and reads the cluster's Nodes), and appends rather
  # than replacing the file cloud-init writes for the guest's own hostname.
  {{- if .HostsLines }}
  - path: /etc/hosts
    append: true
    content: |
  {{- range .HostsLines }}
      {{ . }}
  {{- end }}
  {{- end }}

  - path: /etc/modules-load.d/k8s.conf
    content: |
      overlay
      br_netfilter

  {{- if .KernelModules }}
  # bootstrap.kernelModules: loaded before the sysctls below, because a
  # conntrack parameter is silently dropped when its module is not there.
  - path: /etc/modules-load.d/nodescale.conf
    content: |
  {{- range .KernelModules }}
      {{ . }}
  {{- end }}
  {{- end }}

  - path: /etc/sysctl.d/k8s.conf
    content: |
      net.bridge.bridge-nf-call-iptables  = 1
      net.bridge.bridge-nf-call-ip6tables = 1
      net.ipv4.ip_forward                 = 1

  {{- if .SysctlFile }}
  # bootstrap.sysctls, last in lexical order on purpose: sysctl applies the
  # directory in name order, so 99-zzz-nodescale.conf overrides the image's
  # 99-unixteam-sysctl.conf instead of being overridden by it.
  - path: /etc/sysctl.d/99-zzz-nodescale.conf
    content: |
{{ .SysctlFile }}
  {{- end }}

  {{- if .FullConfigFile }}
  # bootstrap.containerd.configRef: the site owns the whole file. Nothing is
  # generated and imports are left alone.
  - path: /etc/containerd/config.toml
    content: |
{{ .FullConfigFile }}
  {{- end }}

  - path: /etc/kubernetes/join-command.sh
    permissions: '0700'
    content: |
      #!/bin/bash
      set -euo pipefail
      {{ .JoinCommand }}

  - path: /usr/local/sbin/vcd-verify-layout.sh
    permissions: '0700'
    content: |
{{ .LayoutScript }}

  - path: /usr/local/sbin/vcd-ensure-layout.sh
    permissions: '0700'
    content: |
{{ .EnsureScript }}

  - path: /usr/local/sbin/vcd-grow-root.sh
    permissions: '0700'
    content: |
{{ .GrowScript }}

  # The same Option A script the vCD initscript runs in postCustomization:
  # LVM on the data disks, copy /var and /var/lib into the new volumes, fstab by
  # UUID. vCD reboots the guest after customization; here the guest does it once
  # from runcmd below, because moving /var only takes effect on the next boot.
  - path: /usr/local/sbin/prepare-data-disks.sh
    permissions: '0700'
    content: |
{{ .DiskSetupScript }}

  - path: /usr/local/sbin/vcd-grow-data-disks.sh
    permissions: '0700'
    content: |
{{ .GrowDataScript }}

  - path: /usr/local/sbin/k8s-node-prereqs.sh
    permissions: '0700'
    content: |
      #!/bin/bash
      # Stage: OS prerequisites. Slow, network-dependent, retried by systemd.
      # Marker keeps it idempotent; it never touches the cluster.
      set -euo pipefail

      LOG=/var/log/k8s-node-prereqs.log
      exec >>"$LOG" 2>&1
      log() { echo "[$(date -Is)] $*"; }
      log "starting prerequisites {{ .RenderStamp }}"

      # 0. The virtual disk may be bigger than the template's partition table:
      #    a 20 GiB clone of an 8 GiB image leaves / at 7.6 GiB and the apt
      #    below fills it. Grow the root before anything needs the space. It is
      #    idempotent and deliberately outside the marker: a disk extended
      #    later (spec.flavor.osDiskGB) is picked up on the next boot.
      # The growth itself is vcd-grow-disks.service, ordered before this unit:
      # it must also run on every later boot, and this stage runs once.
      if [[ ! -f /etc/kubernetes/grow-disks.done ]]; then
        systemctl start vcd-grow-disks.service || log "growing the filesystems failed; continuing"
        touch /etc/kubernetes/grow-disks.done
      fi

      MARKER=/etc/kubernetes/prereqs.done
      if [[ -f "$MARKER" ]]; then
        log "prerequisites already done"
        exit 0
      fi

{{- if .AptMirror }}
      # 0a. Package sources first: every later step installs something, and on
      #     a network without internet access an image that still points at the
      #     public archive fails at the first apt call. The Terraform baseline
      #     replaces the sources list with the environment's mirror for the
      #     same reason. The file is deb822, which both 22.04 and 24.04 read.
      codename="$(. /etc/os-release && echo "${VERSION_CODENAME:-}")"
      if [[ -z "$codename" ]]; then
        log "cannot derive the release codename; bootstrap.apt.mirror cannot be applied"
        exit 1
      fi
      mirror="{{ .AptMirror }}"
      suites="{{ range $i, $s := .AptSuites }}{{ if $i }} {{ end }}{{ $s }}{{ end }}"
      if [[ -z "$suites" ]]; then
        suites="$codename $codename-updates $codename-backports $codename-security"
      fi
      components="{{ range $i, $c := .AptComponents }}{{ if $i }} {{ end }}{{ $c }}{{ end }}"
      if [[ -z "$components" ]]; then
        components="main universe restricted multiverse"
      fi
      cat >/etc/apt/sources.list.d/nodescale.sources <<EOF
      Types: deb
      URIs: $mirror
      Suites: $suites
      Components: $components
      EOF
      # One active source only: a second copy makes apt fetch every index
      # twice and, worse, keeps a URI that this network cannot reach. The
      # Kubernetes repository added later is left alone.
      for f in /etc/apt/sources.list.d/*.sources /etc/apt/sources.list.d/*.list; do
        [[ -e "$f" ]] || continue
        case "$f" in
          */nodescale.sources|*/kubernetes.list|*.disabled-by-nodescale) continue ;;
        esac
        mv -f "$f" "$f.disabled-by-nodescale"
      done
      if [[ -f /etc/apt/sources.list ]]; then
        sed -ri 's@^([[:space:]]*deb[[:space:]])@# disabled by nodescale: \1@' /etc/apt/sources.list
      fi
      log "apt sources replaced with ${mirror} (${codename})"
{{- end }}
      # 0b. Parity with the Terraform baseline: unattended-upgrades must not
      #     compete for the dpkg lock while the node is being prepared, and
      #     Pro/ESM hooks must not inject repositories the cluster image never
      #     had. Done before any apt call, once.
      systemctl disable --now unattended-upgrades >/dev/null 2>&1 || true
      DEBIAN_FRONTEND=noninteractive apt-get purge --auto-remove -y \
        unattended-upgrades ubuntu-advantage-tools ubuntu-pro-client >/dev/null 2>&1 || true
      rm -f /etc/apt/apt.conf.d/20apt-esm-hook.conf
      sed -i 's/^Prompt.*/Prompt=never/' /etc/update-manager/release-upgrades 2>/dev/null || true
      truncate -s 0 /var/lib/ubuntu-release-upgrader/release-upgrade-available 2>/dev/null || true
      # Written here and not by cloud-init: on this image 10periodic is a
      # conffile of ubuntu-advantage-tools, so the purge above deletes it.
      cat >/etc/apt/apt.conf.d/10periodic <<'APTCONF'
      APT::Periodic::Update-Package-Lists "0";
      APT::Periodic::Download-Upgradeable-Packages "0";
      APT::Periodic::AutocleanInterval "0";
      APT::Periodic::Unattended-Upgrade "0";
      APTCONF
      log "unattended upgrades and Pro hooks removed, periodic apt disabled"

      K8S_MINOR="{{ .K8sMinorRepo }}"
      K8S_VERSION="{{ .K8sVersion }}"
      if [[ -z "$K8S_MINOR" ]]; then
        log "bootstrap.k8sMinorRepo is empty; cannot configure the Kubernetes apt repository"
        exit 1
      fi

      # 1. kubelet requires swap to be disabled.
      swapoff -a || true
      sed -ri 's@^([^#].*[[:space:]]swap[[:space:]].*)@#\1@' /etc/fstab

      # 2. Kernel modules and sysctls (config files are written above).
      modprobe overlay
      modprobe br_netfilter
{{- if .KernelModules }}
  {{- range .KernelModules }}
      modprobe {{ . }} || log "modprobe {{ . }} failed; continuing"
  {{- end }}
{{- end }}
      sysctl --system

      # 2b. The Terraform baseline unloads Ubuntu's apparmor profile for runc:
      #     on kernels where it denies a mount, a pod fails at start with no
      #     useful message. Guarded, because a generic image may ship no
      #     apparmor at all and that is not an error.
      if command -v apparmor_parser >/dev/null 2>&1 && [[ -f /etc/apparmor.d/runc ]]; then
        mkdir -p /etc/apparmor.d/disable
        ln -sf /etc/apparmor.d/runc /etc/apparmor.d/disable/runc
        apparmor_parser -R /etc/apparmor.d/runc 2>/dev/null || true
        log "runc apparmor profile disabled"
      fi

      # 3. containerd.
      if ! command -v containerd >/dev/null 2>&1; then
        apt-get update -y
        DEBIAN_FRONTEND=noninteractive apt-get install -y containerd conntrack socat cloud-guest-utils
      fi
      mkdir -p /etc/containerd
{{- if .FullConfigFile }}
      # bootstrap.containerd.configRef owns the file; only check that the guest
      # really received it.
      if [[ ! -f /etc/containerd/config.toml ]]; then
        log "containerd.configRef is set but /etc/containerd/config.toml is missing"
        exit 1
      fi
{{- else }}
      # A generic image ships no containerd config at all (the package does not
      # own the path) and the built-in defaults use SystemdCgroup=false, which
      # the systemd cgroup driver kubelet runs cannot work with. Generate the
      # base from the installed binary so it matches the version, then write
      # this installation's values into a drop-in.
      if [[ ! -f /etc/containerd/config.toml ]]; then
        containerd config default > /etc/containerd/config.toml
        log "generated /etc/containerd/config.toml from containerd config default"
      fi
      mkdir -p /etc/containerd/conf.d
      if ! grep -q '/etc/containerd/conf.d/\*.toml' /etc/containerd/config.toml; then
        if grep -q '^imports' /etc/containerd/config.toml; then
          sed -i 's|^imports = .*|imports = ["/etc/containerd/conf.d/*.toml"]|' /etc/containerd/config.toml
        else
          sed -i '1i imports = ["/etc/containerd/conf.d/*.toml"]' /etc/containerd/config.toml
        fi
        log "enabled /etc/containerd/conf.d imports"
      fi
      # containerd 2.x renamed the CRI plugin: the runtime section is
      # io.containerd.cri.v1.runtime and images (sandbox, registry) are
      # io.containerd.cri.v1.images, while 1.x keeps both under
      # io.containerd.grpc.v1.cri (a base file declaring version = 2, which
      # containerd 2.x still accepts through its legacy mapping). A key in the
      # wrong layout is ignored with a warning and SystemdCgroup silently stays
      # false, so the layout is read from the base file, not assumed from the
      # binary version.
      runtime_plugin=io.containerd.grpc.v1.cri
      images_plugin=io.containerd.grpc.v1.cri
      sandbox_section="[plugins.\"io.containerd.grpc.v1.cri\"]"
      sandbox_key=sandbox_image
      if grep -qE '^[[:space:]]*version[[:space:]]*=[[:space:]]*3' /etc/containerd/config.toml ||
        grep -q 'io.containerd.cri.v1.images' /etc/containerd/config.toml; then
        runtime_plugin=io.containerd.cri.v1.runtime
        images_plugin=io.containerd.cri.v1.images
        sandbox_section="[plugins.\"io.containerd.cri.v1.images\".pinned_images]"
        sandbox_key=sandbox
      fi
      {
        echo "[plugins.\"${runtime_plugin}\".containerd.runtimes.runc.options]"
        echo '  SystemdCgroup = true'
{{- if .ContainerdSandboxImage }}
        echo "${sandbox_section}"
        echo "  ${sandbox_key} = \"{{ .ContainerdSandboxImage }}\""
{{- end }}
{{- range .ContainerdMirrors }}
        if [[ "$images_plugin" != "io.containerd.cri.v1.images" ]]; then
          echo "[plugins.\"${images_plugin}\".registry.mirrors.\"{{ .Host }}\"]"
          echo '  endpoint = [{{ range $i, $e := .Endpoints }}{{ if $i }}, {{ end }}"{{ $e }}"{{ end }}]'
        fi
{{- end }}
{{- if .ContainerdInsecure }}
        if [[ "$images_plugin" != "io.containerd.cri.v1.images" ]]; then
{{- range .ContainerdMirrors }}
          echo "[plugins.\"${images_plugin}\".registry.configs.\"{{ .Host }}\".tls]"
          echo '  insecure_skip_verify = true'
{{- end }}
        fi
{{- end }}
      } > /etc/containerd/conf.d/10-nodescale.toml
      log "wrote the containerd drop-in for ${runtime_plugin}"
{{- if .ContainerdInsecure }}
{{- range .ContainerdMirrors }}
      # containerd 2.x takes per-registry TLS from a certs.d hosts.toml, not
      # from registry.configs. The file also lists the endpoints, so the
      # drop-in above leaves this registry out on 2.x.
      if [[ "$images_plugin" == "io.containerd.cri.v1.images" ]]; then
        mkdir -p "/etc/containerd/certs.d/{{ .Host }}"
        cat > "/etc/containerd/certs.d/{{ .Host }}/hosts.toml" <<'NODESCALE_HOSTS'
      server = "https://{{ .Host }}"
{{- range .Endpoints }}
      [host."{{ . }}"]
        capabilities = ["pull", "resolve"]
        skip_verify = true
{{- end }}
      NODESCALE_HOSTS
      fi
{{- end }}
{{- end }}
{{- end }}
      systemctl enable containerd
      systemctl restart containerd
      if command -v containerd >/dev/null 2>&1; then
        if ! containerd config dump 2>/dev/null | grep -q 'SystemdCgroup = true'; then
          log "WARNING: SystemdCgroup is not true in the effective containerd config"
          log "WARNING: if this containerd is 2.x, its CRI keys are io.containerd.cri.v1.*; set bootstrap.containerd.configRef"
        fi
      fi

      # 4. Kubernetes binaries, pinned when a version is configured.
      if ! command -v kubeadm >/dev/null 2>&1; then
        apt-get update -y
        DEBIAN_FRONTEND=noninteractive apt-get install -y ca-certificates curl gpg apt-transport-https
        install -d -m 0755 /etc/apt/keyrings
        curl -fsSL "https://pkgs.k8s.io/core:/stable:/${K8S_MINOR}/deb/Release.key" \
          | gpg --batch --yes --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg
        echo "deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/${K8S_MINOR}/deb/ /" \
          > /etc/apt/sources.list.d/kubernetes.list
        apt-get update -y
        if [[ -n "$K8S_VERSION" ]]; then
          DEBIAN_FRONTEND=noninteractive apt-get install -y \
            "kubelet=${K8S_VERSION}" "kubeadm=${K8S_VERSION}" "kubectl=${K8S_VERSION}"
        else
          DEBIAN_FRONTEND=noninteractive apt-get install -y kubelet kubeadm kubectl
        fi
        apt-mark hold kubelet kubeadm kubectl
      fi
      systemctl enable kubelet

      touch "$MARKER"
      log "prerequisites done"

  - path: /usr/local/sbin/k8s-node-join.sh
    permissions: '0700'
    content: |
      #!/bin/bash
      # Stage: join the cluster. The only step that changes cluster state, so it
      # waits for the prerequisites and for the API instead of failing fast.
      set -euo pipefail

      LOG=/var/log/k8s-node-join.log
      exec >>"$LOG" 2>&1
      log() { echo "[$(date -Is)] $*"; }
      log "starting join {{ .RenderStamp }}"

      MARKER=/etc/kubernetes/kubeadm-joined
      if [[ -f "$MARKER" ]]; then
        log "already joined"
        exit 0
      fi
      # kubeadm writes kubelet.conf on success; the marker is the authority.
      if [[ -f /etc/kubernetes/kubelet.conf ]]; then
        log "kubelet.conf exists; recording the marker"
        touch "$MARKER"
        exit 0
      fi

      ENDPOINT="{{ .JoinEndpoint }}"

      # Wait for the prerequisites (they retry independently in their own unit).
      for _ in $(seq 1 30); do
        [[ -f /etc/kubernetes/prereqs.done ]] && break
        sleep 10
      done
      if [[ ! -f /etc/kubernetes/prereqs.done ]]; then
        log "prerequisites are not finished yet"
        exit 1
      fi

      # Wait for the API server instead of burning an attempt on a cold route.
      if [[ -n "$ENDPOINT" ]]; then
        api=0
        for _ in $(seq 1 24); do
          if curl -skf --max-time 5 "https://$ENDPOINT/healthz" >/dev/null 2>&1; then
            api=1
            break
          fi
          sleep 5
        done
        if [[ "$api" -ne 1 ]]; then
          log "API $ENDPOINT is not reachable"
          exit 1
        fi
        log "API $ENDPOINT reachable"
      fi

      # kubeadm has no timeout of its own: when discovery cannot be verified
      # (observed: a token whose cluster-info JWS entry was missing) it prints
      # "...pre-flight checks" and waits forever. Bound it so the unit fails,
      # retries and reports instead of sitting in "activating" for hours.
      log "running kubeadm join (15m timeout)"
      if ! timeout 900 bash /etc/kubernetes/join-command.sh; then
        log "kubeadm join failed or timed out"
        exit 1
      fi
      touch "$MARKER"
      log "join finished"

  # Runs on every boot, before anything needs the space: a disk grown by a
  # later resize is only useful once the guest has grown into it. Both scripts
  # are idempotent, so a boot that changes nothing costs a few milliseconds.
  - path: /etc/systemd/system/vcd-grow-disks.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Grow the root and data filesystems into the space vCD gave us
      After=local-fs.target vcd-ensure-layout.service
      Before=k8s-node-prereqs.service k8s-node-join.service
      StartLimitIntervalSec=0

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/vcd-grow-root.sh
      ExecStart=/usr/local/sbin/vcd-grow-data-disks.sh
      RemainAfterExit=yes
      TimeoutStartSec=10min

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/vcd-ensure-layout.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Mount the data disks where the spec says
      After=local-fs.target
      Before=k8s-node-prereqs.service k8s-node-join.service
      ConditionPathExists=/etc/vcd-data-disks.done
      StartLimitIntervalSec=0

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/vcd-ensure-layout.sh
      RemainAfterExit=yes
      Restart=on-failure
      RestartSec=15

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/k8s-node-prereqs.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Prepare the worker OS (packages, containerd, sysctl)
      Wants=network-online.target vcd-ensure-layout.service
      After=network-online.target vcd-ensure-layout.service
      ConditionPathExists=!/etc/kubernetes/prereqs.done
      StartLimitIntervalSec=0

      [Service]
      Type=oneshot
      # apt and dpkg live on /var/lib: refuse to run on an empty layout instead
      # of failing with "Could not open lock file /var/lib/dpkg/lock-frontend".
      ExecStartPre=/usr/local/sbin/vcd-verify-layout.sh
      ExecStart=/usr/local/sbin/k8s-node-prereqs.sh
      RemainAfterExit=yes
      Restart=on-failure
      RestartSec=60
      TimeoutStartSec=30min

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/k8s-node-join.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Join the Kubernetes cluster as a worker
      Wants=network-online.target k8s-node-prereqs.service vcd-ensure-layout.service
      After=network-online.target k8s-node-prereqs.service vcd-ensure-layout.service
      ConditionPathExists=!/etc/kubernetes/kubeadm-joined
      StartLimitIntervalSec=0

      [Service]
      Type=oneshot
      ExecStartPre=/usr/local/sbin/vcd-verify-layout.sh
      ExecStart=/usr/local/sbin/k8s-node-join.sh
      RemainAfterExit=yes
      Restart=on-failure
      RestartSec=60
      TimeoutStartSec=45min

      [Install]
      WantedBy=multi-user.target

runcmd:
{{- if .CACertFiles }}
  # Trust the pool's CA bundle before anything reaches the network: apt, the
  # Kubernetes repository and the container registry all use it.
  - update-ca-certificates
{{- if .DNSServersLine }}
  - systemctl restart systemd-resolved || true
{{- end }}
{{- end }}
{{- if .NTPServers }}
  # bootstrap.ntpServers: the Terraform baseline sets the same sources per
  # cluster. The block is marked so a re-run replaces it instead of appending.
  - |
    if [ -f /etc/chrony/chrony.conf ]; then
      sed -i '/^# BEGIN nodescale ntp$/,/^# END nodescale ntp$/d' /etc/chrony/chrony.conf
      {
        echo '# BEGIN nodescale ntp'
      {{- range .NTPServers }}
        echo 'server {{ . }} iburst'
      {{- end }}
        echo '# END nodescale ntp'
      } >> /etc/chrony/chrony.conf
      systemctl restart chrony 2>/dev/null || true
    fi
{{- end }}
  - systemctl daemon-reload
  - systemctl enable vcd-grow-disks.service vcd-ensure-layout.service
  - systemctl enable k8s-node-prereqs.service k8s-node-join.service
{{- if .Disks }}
  # Prepare the data disks and reboot once, exactly like vCD after the
  # post-customization phase. The reboot is what makes /var and /var/lib mount
  # from fstab; on the next boot the enabled units install the packages and
  # join. A failed preparation does not reboot, so the VM stays inspectable.
  - /usr/local/sbin/prepare-data-disks.sh && /sbin/reboot
{{- else }}
  - systemctl start --no-block vcd-ensure-layout.service
  - systemctl enable --now --no-block k8s-node-prereqs.service
  - systemctl enable --now --no-block k8s-node-join.service
{{- end }}
{{- if .SSHAllowedSources }}
  # The image restricts sshd with an AllowUsers line; the Terraform baseline
  # appends allowed_ssh_ips to it. Add the pool's sources the same way, once
  # each, before sshd is restarted below.
  - |
    for src in {{ range .SSHAllowedSources }}{{ . }} {{ end }}; do
      [ -z "$src" ] && continue
      grep -q -- "$src" /etc/ssh/sshd_config && continue
      if grep -q '^AllowUsers' /etc/ssh/sshd_config; then
        sed -i "/^AllowUsers/ s|$| $src|" /etc/ssh/sshd_config
      else
        echo "AllowUsers $src" >> /etc/ssh/sshd_config
      fi
    done
{{- end }}
  # The sshd drop-in above is read at start, and the image's socket unit may be
  # the one that answers: restart all three the way the Terraform baseline does.
  - systemctl restart ssh ssh.socket ssh.service || true
